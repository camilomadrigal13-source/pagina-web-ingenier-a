# Variables del SERVIDOR (Vercel → Settings → Environment Variables). Nunca van en el código del sitio.
# Se envía por todos los canales configurados. Guía completa: docs/INTEGRACIONES.md

# Correo (Resend)
RESEND_API_KEY=
CONTACT_TO=correo-que-recibe@tudominio.co
CONTACT_FROM=Sitio web <web@tudominio.co>

# Hoja de cálculo (Google Apps Script)
SHEETS_WEBHOOK_URL=
SHEETS_TOKEN=

# WhatsApp: elegir un proveedor
# Valores posibles: callmebot o meta
WA_PROVIDER=
# callmebot
CALLMEBOT_PHONE=
CALLMEBOT_APIKEY=
# meta (WhatsApp Cloud API)
WA_META_TOKEN=
WA_META_PHONE_ID=
WA_META_TO=
WA_META_TEMPLATE=
WA_META_LANG=es

# Opcional
ALLOWED_ORIGINS=
SITE_URL=https://tudominio.co
